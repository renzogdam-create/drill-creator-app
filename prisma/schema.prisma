generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserRole { COACH ADMIN }
enum PreferenceType { COORDINATIVE COGNITIVE GAME_CONTEXTUAL RECOVERY MATCH_PREPARATION OTHER }
enum DrillType { RONDO POSSESSION_GAME POSITIONAL_GAME PROGRESSION_GAME FINISHING ATTACKING DEFENDING CONTROL_PASS SMALL_SIDED_GAME TECHNICAL_TACTICAL ACTIVATION OTHER }
model User { id String @id @default(cuid()) name String email String @unique role UserRole @default(COACH) teams Team[] concepts TrainingConcept[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Team { id String @id @default(cuid()) ownerId String name String ageGroup String season String clubName String players Player[] annualPlans AnnualTrainingPlan[] gameSheets GameSheet[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User @relation(fields:[ownerId], references:[id]) }
model Player { id String @id @default(cuid()) teamId String firstName String lastName String dateOfBirth DateTime position String preferredFoot String shirtNumber Int? photoUrl String? notes String? technicalRating Int? tacticalRating Int? physicalRating Int? psychologicalRating Int? socialRating Int? strengths String? developmentAreas String? individualObjectives String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt team Team @relation(fields:[teamId], references:[id]) selections PlayerSelection[] }
model AnnualTrainingPlan { id String @id @default(cuid()) teamId String season String title String description String? mainObjectives String? mesocycles Mesocycle[] team Team @relation(fields:[teamId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Mesocycle { id String @id @default(cuid()) annualTrainingPlanId String title String order Int startDate DateTime endDate DateTime mainObjective String? cognitiveBlock String? notes String? microcycles Microcycle[] annualTrainingPlan AnnualTrainingPlan @relation(fields:[annualTrainingPlanId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Microcycle { id String @id @default(cuid()) mesocycleId String title String order Int weekNumber Int startDate DateTime endDate DateTime objective String? cognitiveBlock String? coordinativeFocus String? tacticalFocus String? gameContext String? notes String? sessions TrainingSession[] mesocycle Mesocycle @relation(fields:[mesocycleId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TrainingSession { id String @id @default(cuid()) microcycleId String title String sessionNumber Int date DateTime duration Int location String? preference PreferenceType sessionObjective String? objectiveInPossession String? operationalFocusInPossession String? objectiveInRecovery String? operationalFocusInRecovery String? coachNotes String? blocks SessionBlock[] selections PlayerSelection[] microcycle Microcycle @relation(fields:[microcycleId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model SessionBlock { id String @id @default(cuid()) trainingSessionId String order Int title String duration Int pssType String? drillId String? notes String? trainingSession TrainingSession @relation(fields:[trainingSessionId], references:[id]) drill Drill? @relation(fields:[drillId], references:[id]) }
model Drill { id String @id @default(cuid()) title String type DrillType ageGroup String? duration Int? load String? restBetweenRounds String? minPlayers Int? recommendedPlayers Int? footballVariant String? difficulty String? area String? materialNeeded String? generalObjective String? organization String? description String? drillFlow String? rulesAndConstraints String? coachingFocusInPossession String? coachingFocusInRecovery String? scoringSystem String? progressions String? keyTransferToGame String? graphicUrl String? tags String[] sessionBlocks SessionBlock[] selections PlayerSelection[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model GameSheet { id String @id @default(cuid()) teamId String opponent String date DateTime competition String? venue String? formation String? gameModel String? startingLineup Json? substitutes Json? tacticalObjectives String? inPossessionPlan String? outOfPossessionPlan String? transitionAttackPlan String? transitionDefensePlan String? setPieces String? playerMinutes Json? matchNotes String? postMatchReflection String? team Team @relation(fields:[teamId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PlayerSelection { id String @id @default(cuid()) trainingSessionId String? drillId String? playerId String groupName String? positionInGrid String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt trainingSession TrainingSession? @relation(fields:[trainingSessionId], references:[id]) drill Drill? @relation(fields:[drillId], references:[id]) player Player @relation(fields:[playerId], references:[id]) }
model TrainingConcept { id String @id @default(cuid()) userId String title String category String preference String? content String order Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id]) }
